rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Migration safety rule: recovered production state is accessible only
    // to the explicitly authorized Firebase Auth user.
    match /workspaces/github-prod/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'GntsaU7i2tXdDf05ds8cws5dfi63';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
